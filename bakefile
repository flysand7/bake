
func 'cli' build(args) {
    let exe_name = 'bake.exe'
    print('=> Adding a recipe\n')
    bake-recipe(
        [['odin', 'build', 'src', "-out:${exe_name}", '-debug']],
        [
            'src/bake.odin',
            'src/bakefile.odin',
            'src/build_test.odin',
            'src/build.odin',
            'src/cache.odin',
            'src/exec.odin',
            'src/file_windows.odin',
            'src/parser.odin',
            'src/script_builtin.odin',
            'src/script_error.odin',
            'src/script.odin',
        ],
        [exe_name],
    )
    print('=> Calling build\n')
    bake-build([exe_name])
}

func 'cli' test(args) {
    cmd(exe-name, 1, 2, 3)
}

